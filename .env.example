# ============================================================
# junaedhossain.com - environment template
# Copy to .env.local and fill in. NEVER commit real values.
# Production values live in Vercel -> Settings -> Environment Variables
# and GitHub -> Settings -> Secrets and variables -> Actions.
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL=https://junaedhossain.com
ADMIN_URL=https://admin.junaedhossain.com
# 64+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Encrypts TOTP secrets and stored tokens at rest
ENCRYPTION_KEY=
# Signs the math-captcha token
CAPTCHA_SECRET=
# Salt for hashing visitor IPs (never store raw IPs)
IP_HASH_SALT=

# ---- Database (Neon Postgres) ----
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- Rate limiting (Upstash Redis) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Seed owner (first run only, then remove) ----
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---- GitHub Actions secrets only (backup job) ----
CPANEL_SFTP_HOST=
CPANEL_SFTP_PORT=21098
CPANEL_SFTP_USER=
CPANEL_SFTP_KEY=
CPANEL_BACKUP_DIR=/home/<cpanel_user>/backups/junaed
BACKUP_AGE_PUBLIC_KEY=

# ---- Admin panel -> GitHub dispatch (Phase 9) ----
# Fine-grained token, Actions: write on this repository only.
GITHUB_BACKUP_TOKEN=
GITHUB_REPOSITORY=zonaedh/junaed-website
GITHUB_BACKUP_WORKFLOW=backup-weekly.yml