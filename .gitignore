# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# backups / dumps
*.sql
*.sql.gz
*.dump
/backups/

# drizzle generated meta is committed, but local sqlite/journal is not
*.db
*.db-journal

# scratch
/_scaffold

# local embedded postgres data
/.pgdata/
/.pglite/

# local media uploads (dev-only disk driver; production uses R2)
/public/uploads/
